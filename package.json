{
  "name": "pc-shop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "db:init": "node --env-file-if-exists=.env server/init-db.js",
    "test": "node --test",
    "test:db": "node --env-file-if-exists=.env scripts/check-db.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mssql": "^12.0.0",
    "msnodesqlv8": "^5.0.0"
  }
}
